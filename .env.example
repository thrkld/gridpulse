POSTGRES_PASSWORD=mypassword

PGHOST=myazureserverhostname
PGSSLMODE=verify-full
# only needed off Linux: path to a CA bundle libpq can read, e.g.
# python -c 'import certifi; print(certifi.where())'
PGSSLROOTCERT=/path/to/cacert.pem
PGPASSWORD=myazurepassword

DAGSTER_PG_HOST=myazureserverhostname
DAGSTER_PG_USER=gridpulse
DAGSTER_PG_PASSWORD=myazurepassword
DAGSTER_PG_DB=dagster

# Metabase dashboard provisioning (keep the real key in .env).
METABASE_URL=http://localhost:3002
METABASE_API_KEY=
# Optional: reuse an existing Metabase data connection by its numeric ID.
# METABASE_DATABASE_ID=2
# Optional CA bundle on this machine; falls back to PGSSLROOTCERT, then certifi.
# Uploaded to Metabase when using verify-full or verify-ca.
# METABASE_PGSSLROOTCERT=/path/to/root.pem
# Defaults to PG* for hosted data. For local Docker marts, override:
# METABASE_PGHOST=postgres
# METABASE_PGSSLMODE=disable
# METABASE_PGPASSWORD uses POSTGRES_PASSWORD automatically for host=postgres.

# Static dashboard publishing (the Dagster asset dashboard_site). A fine-grained
# GitHub token with Contents read/write on the dashboard repository only.
DASHBOARD_REPO=thrkld/gridpulse-dashboard
DASHBOARD_BRANCH=main
DASHBOARD_TOKEN=
